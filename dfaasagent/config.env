AGENT_DEBUG=true
AGENT_LOG_DATETIME=true
AGENT_LOG_COLORS=true

LOG_LEVEL="debug"
LOG_FILE="agent.log"
# IP address of the node where the agent runs.
AGENT_NODE_IP="10.12.38.8"

# Address where to listen new peers.
AGENT_LISTEN="/ip4/0.0.0.0/tcp/31600"

# Agent private key.
AGENT_PRIVATE_KEY_FILE="privatekey.pem"

# Node A is our bootstrap/master node.
AGENT_BOOTSTRAP_NODES=false

AGENT_PUBLIC_BOOTSTRAP_NODES=false

# Node A does not need to bootstrap from another DFaaS node.
AGENT_BOOTSTRAP_NODES_LIST=""

AGENT_BOOTSTRAP_FORCE=false

AGENT_RENDEZVOUS="dfaasagent-mYRGdJPC3chmJ"

AGENT_KAD_IDLE_TIME="1m"
AGENT_PUBSUB_TOPIC="/dfaasagent/1.0.0"

AGENT_MDNS_ENABLED=false

AGENT_RECALC_PERIOD="15s"

AGENT_HAPROXY_HOST="10.12.38.8"
AGENT_HAPROXY_PORT="30080"

AGENT_DATAPLANEAPI_HOST="10.12.38.8"
AGENT_DATAPLANEAPI_PORT=30555
AGENT_DATAPLANEAPI_USER="admin"
AGENT_DATAPLANEAPI_PASSWORD="admin"

AGENT_RUNTIMEAPI_HOST="10.12.38.8"
AGENT_RUNTIMEAPI_PORT=30666

AGENT_FAAS_HOST="10.12.38.8"
AGENT_FAAS_PORT=31112

AGENT_REJECTOR_HOST="10.12.38.8"
AGENT_REJECTOR_PORT=30880

AGENT_PROMETHEUS_HOST="10.12.38.8"
AGENT_PROMETHEUS_PORT=30909
AGENT_PROMETHEUS_STEP=5s

AGENT_STRATEGY="costbasedstrategy"
AGENT_LATENCY_THRESHOLD_MS=10

AGENT_FAAS_PLATFORM="openfaas"
